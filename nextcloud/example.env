# nextcloud SQL variables
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# redis server variables
REDIS_PASSWORD=

# nextcloud office variables
COLLABORA_USERNAME=
COLLABORA_PASSWORD=
COLLABORA_DOMAIN=collabora.your_nextcloud_domain.tld # replace with your subdomain

# nextcloud talk variables
TURN_SECRET_KEY= # generate with openssl rand -hex 32   
SIGNALING_SECRET_KEY= # generate with openssl rand -hex 32   
INTERNAL_SECRET_KEY= # generate with openssl rand -hex 32   
SIGNALING_DOMAIN=signaling.you_nextcloud_domain.tld # replace with your subdomain

# nextcloud whiteboard variables
WHITEBOARD_DOMAIN=whiteboard.you_nextcloud_domain.tld # replace with your subdomain
WHITEBOARD_SECRET_KEY= # generate with openssl rand -hex 32   

HP_SHARED_KEY= # generate with openssl rand -hex 32   

TIMEZONE=Europe/Sofia
NC_DOMAIN=your.your_nextcloud_domain.tld # replace whit your domain
